{
  "realm": "drims",
  "enabled": true,
  "roles": {
    "realm": [
      {"name": "Admin"},
      {"name": "Inventory Controller"},
      {"name": "Warehouse Supervisor"},
      {"name": "Viewer"},
      {"name": "System Integration"}
    ]
  },
  "clients": [
    {
      "clientId": "drims-web",
      "name": "DRIMS Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*", "http://frontend/*"],
      "webOrigins": ["http://localhost:3000", "http://frontend"],
      "attributes": {"pkce.code.challenge.method": "S256"}
    },
    {
      "clientId": "drims-api",
      "name": "DRIMS API",
      "enabled": true,
      "publicClient": false,
      "secret": "drims-api-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "drims-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "drims-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "site-ids",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "site_ids",
            "claim.name": "site_ids",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@drims.local",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "realmRoles": ["Admin"],
      "attributes": {"site_ids": ["WH01"]},
      "credentials": [{"type": "password", "value": "adminpass", "temporary": false}]
    },
    {
      "username": "inventory_controller",
      "email": "controller@drims.local",
      "emailVerified": true,
      "firstName": "Inventory",
      "lastName": "Controller",
      "enabled": true,
      "realmRoles": ["Inventory Controller"],
      "attributes": {"site_ids": ["WH01"]},
      "credentials": [{"type": "password", "value": "controllerpass", "temporary": false}]
    },
    {
      "username": "warehouse_supervisor",
      "email": "supervisor@drims.local",
      "emailVerified": true,
      "firstName": "Warehouse",
      "lastName": "Supervisor",
      "enabled": true,
      "realmRoles": ["Warehouse Supervisor"],
      "attributes": {"site_ids": ["WH01"]},
      "credentials": [{"type": "password", "value": "supervisorpass", "temporary": false}]
    },
    {
      "username": "viewer",
      "email": "viewer@drims.local",
      "emailVerified": true,
      "firstName": "Viewer",
      "lastName": "User",
      "enabled": true,
      "realmRoles": ["Viewer"],
      "attributes": {"site_ids": ["WH01"]},
      "credentials": [{"type": "password", "value": "viewerpass", "temporary": false}]
    },
    {
      "username": "integration_account",
      "email": "integration@drims.local",
      "emailVerified": true,
      "firstName": "Integration",
      "lastName": "Account",
      "enabled": true,
      "realmRoles": ["System Integration"],
      "attributes": {"site_ids": ["WH01"]},
      "credentials": [{"type": "password", "value": "integrationpass", "temporary": false}]
    },
    {
      "username": "service-account-drims-api",
      "enabled": true,
      "serviceAccountClientId": "drims-api",
      "realmRoles": ["System Integration"],
      "attributes": {"site_ids": ["WH01"]}
    }
  ]
}
