# DIMS - Drone Inventory Management System
# Environment variables for Phase 1 foundation

# ============================================================
# Database Configuration
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=drims
DB_USER=drims
DB_PASSWORD=drims_password

# ============================================================
# PostgreSQL Settings
# ============================================================
# Note: For Docker local development, PostgreSQL uses trust authentication
# For production, set DB_PASSWORD and configure pg_hba.conf

# ============================================================
# MinIO (Object Storage - S3 API)
# ============================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ============================================================
# Keycloak (OIDC Authentication)
# ============================================================
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=drims
KEYCLOAK_CLIENT_ID=drims-api
KEYCLOAK_CLIENT_SECRET=secret

# ============================================================
# Application Settings
# ============================================================
DEBUG=False
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================
# Processing Configuration
# ============================================================
# Location mapping time window (seconds)
LOCATION_TIME_WINDOW_SECONDS=3

# Bin count confidence threshold
BIN_COUNT_CONFIDENCE_THRESHOLD=0.80

# Reconciliation variance threshold
RECONCILIATION_VARIANCE_THRESHOLD=10

# Weight defaults for confidence calculation (w1 + w2 + w3 = 1)
W1_DEFAULT=0.5    # avg_read_confidence
W2_DEFAULT=0.3    # location_method_score
W3_DEFAULT=0.2    # image_coverage_ratio

# IRA (Item Reconciliation Accuracy) threshold
IRA_THRESHOLD=0.80

# Retention policies (days)
SCAN_DATA_RETENTION_DAYS=730      # 2 years
IMAGE_RETENTION_HOT_DAYS=90       # 90 days hot, then archive
AUDIT_LOG_RETENTION_DAYS=2555     # 7 years

# ============================================================
# Rate Limiting
# ============================================================
INGESTION_RATE_LIMIT=200          # scans per second
API_RATE_LIMIT=100                # requests per minute

# ============================================================
# File Size Limits (bytes)
# ============================================================
MAX_PAYLOAD_SIZE=10485760       # 10 MB
MAX_IMAGE_SIZE=104857600        # 100 MB