FROM python:3.13-slim

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY app /app/app
COPY backend/db /app/backend/db
COPY Dataset/drone_inventory_outputs /app/Dataset/drone_inventory_outputs
COPY tests /app/tests
COPY ops/backend-entrypoint.sh /app/ops/backend-entrypoint.sh

ENV PYTHONPATH=/app

RUN useradd --create-home --uid 10001 drims
RUN chmod +x /app/ops/backend-entrypoint.sh
USER drims

ENTRYPOINT ["/app/ops/backend-entrypoint.sh"]
