FROM python:3.13-slim

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY app /app/app
COPY backend/db /app/backend/db

ENV PYTHONPATH=/app

RUN useradd --create-home --uid 10001 drims
USER drims

CMD ["celery", "-A", "app.worker_app:celery_app", "worker", "--loglevel=INFO"]
