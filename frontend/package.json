    "@tanstack/react-query": "^5.51.0",
    "antd": "^5.14.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.2",
    "i18next": "^23.14.0",
    "keycloak-js": "^25.0.1",
    "konva": "^9.3.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^15.0.0",
    "react-konva": "^18.2.10",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^24.1.1",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.5.4",
    "vite": "^8.3.4",
